import api from "./axioInstance.js";


export const checkinApi = {
  generateQr: (gymId) => api.post('/qr/generate', { gymId }),
  checkIn: (gymId, qrToken) => api.post('/checkins', { gymId, qrToken }),
  getMyHistory: () => api.get('/checkins/history'),
  getGymCheckinsToday: (gymId) => api.get(`/checkins/gym/${gymId}`),
};
